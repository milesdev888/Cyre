      ]
    },
    {
      "source": "/monitor",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/monitor.html",
      "headers": [
        {
          "key": "Cache-Control",
