  "redirects": [
    {
      "source": "/verify/:serial",
      "destination": "/verify?serial=:serial",
      "permanent": false
    },
    {
      "source": "/v/:serial",
      "destination": "/verify?serial=:serial",
      "permanent": false
    },
    {
      "source": "/scan",
      "missing": [
        {
          "type": "query",
          "key": "embed",
          "value": "1"
        }
      ],
      "destination": "https://scan.cyre.dev/app",
      "permanent": false
    },
    {
      "source": "/scan.html",
      "missing": [
        {
          "type": "query",
          "key": "embed",
          "value": "1"
        }
      ],
      "destination": "https://scan.cyre.dev/app",
      "permanent": false
    },
    {
      "source": "/apps",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/airdrop",
      "permanent": true
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "https://cyre-fraud-prediction.onrender.com/.well-known/agent-card.json",
      "permanent": true
    }
  ],
