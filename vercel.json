{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/badge-og.js": {
      "includeFiles": "brand/seals/**"
    },
    "api/badge-seal.js": {
      "includeFiles": "brand/seals/**"
    },
    "api/verify-og.js": {
      "includeFiles": "brand/seals/**"
    },
    "api/cert-image.js": {
      "memory": 1024
    },
    "api/cert-blend.js": {
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/token-metadata.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/c7-cobra-:size.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/c7-cobra-:size-transparent.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(cyre-token-icon|cyre-token-ticker|cyre-token|guardian-c7-cobra)-:size.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
